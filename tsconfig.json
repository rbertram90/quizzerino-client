{
    "compilerOptions": {
        "target": "ES2022",
        "lib": ["DOM", "DOM.Iterable", "ES2022"],
        "module": "ESNext",
        "moduleResolution": "bundler",
        "jsx": "preserve",
        "sourceMap": true,
        "outDir": "public/app/dist",
        "rootDir": "public/app",
        "strict": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "forceConsistentCasingInFileNames": true,
        "strictPropertyInitialization": false
    },
    "compileOnSave": true,
    "exclude": [
        "node_modules",
        "**/node_modules/*",
        "public/app/dist"
    ],
    "include": [
        "public/app/**/*.ts"
    ]
}